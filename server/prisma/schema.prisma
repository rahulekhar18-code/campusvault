datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STUDENT
  ADMIN
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  password     String
  role         Role               @default(STUDENT)
  isVerified   Boolean            @default(false)
  otp          String?
  otpExpiresAt DateTime?
  credits      Int                @default(50)
  referralCode String?            @unique
  referredById String?
  referredBy   User?              @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]             @relation("UserReferrals")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  resources    Resource[]
  bookmarks    Bookmark[]
  unlockedFiles UnlockedResource[]

  @@map("users")
}

model Resource {
  id              String             @id @default(cuid())
  title           String
  branch          String
  semester        String
  subject         String
  unit            String             @default("Unit 1") // Unit 1, Unit 2, Unit 3, Unit 4, Unit 5, Unit 6, General
  category        String             // Notes, PYQ, Practicals, Assignments, Placement
  originalName    String
  storageKey      String
  bucketName      String             @default("campusvault-files")
  fileSize        Int
  mimeType        String
  status          ApprovalStatus     @default(PENDING)
  rejectionReason String?
  isLocked        Boolean            @default(false)
  isStrictLock    Boolean            @default(false)    // Admin master lock: if true, strictly non-downloadable
  creditCost      Int                @default(10)       // Credits required to unlock
  isTopperVerified Boolean           @default(false)
  isProfVerified   Boolean           @default(false)
  uploaderId      String
  uploader        User               @relation(fields: [uploaderId], references: [id], onDelete: Cascade)
  bookmarks       Bookmark[]
  unlockedBy      UnlockedResource[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([status])
  @@index([branch, semester, subject])
  @@index([branch, semester, subject, unit])
  @@map("resources")
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  resourceId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, resourceId])
  @@index([userId])
  @@map("bookmarks")
}

model UnlockedResource {
  id           String   @id @default(cuid())
  userId       String
  resourceId   String
  creditsSpent Int      @default(10)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource     Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([userId, resourceId])
  @@index([userId])
  @@map("unlocked_resources")
}

model AppSettings {
  id                    String   @id @default("global")
  appName               String   @default("CampusVault")
  logoUrl               String   @default("")
  themeColor            String   @default("#2563eb")
  storageRoot           String   @default("vault")
  folderFormat          String   @default("{branch}/{semester}/{subject}/{category}")
  maxFileSizeMB         Int      @default(25)
  announcementText      String   @default("")
  announcementEnabled   Boolean  @default(false)
  announcementType      String   @default("info") // "info" | "warning" | "success"
  autoApproveUploads    Boolean  @default(false)  // Fast exam mode
  defaultLockMode       Boolean  @default(false)  // In-app read-only default
  allowedEmailDomains   String   @default("ycce.in") // Comma-separated college domains
  preventScreenCapture  Boolean  @default(true)   // Anti-screenshot & DRM shield
  updatedAt             DateTime @updatedAt

  @@map("app_settings")
}

model AcademicBranch {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_branches")
}

model AcademicSemester {
  id        String   @id @default(cuid())
  name      String   @unique
  number    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_semesters")
}

model AcademicCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("academic_categories")
}

model AcademicSubject {
  id        String   @id @default(cuid())
  name      String
  branch    String   @default("IT")
  semester  String   // "1" to "8"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, branch, semester])
  @@index([branch, semester])
  @@map("academic_subjects")
}
